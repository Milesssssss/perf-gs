static const uint NUM_COLMAP_POINTS = 100;

/*$(_compute:fillBufferFromColmap)*/(uint3 DTid : SV_DispatchThreadID)
{
    uint idx = DTid.x;

    if (idx >= NUM_COLMAP_POINTS) return;

    if (idx == 0)
    {
        num_gaussians_counter[0] = NUM_COLMAP_POINTS;
        training_step_counter[0] = 0;
    }

    input_gaussians[idx].mean = COLMAP_POINTS[idx];
    input_gaussians[idx].log_scale = log(.25);  // Small initial scale
    input_gaussians[idx].rotation_quat = float4(1, 0, 0, 0);    // Identity
    input_gaussians[idx].opacity = 0.1;
    input_gaussians[idx].color_logit = logit3(float3(0.5, 0.5, 0.5));  // Gray like source
}
